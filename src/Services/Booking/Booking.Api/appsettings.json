{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Resilience": {
    "TotalTimeoutSeconds": 10,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMilliseconds": 200,
    "CircuitFailureRatio": 0.5,
    "CircuitMinimumThroughput": 5,
    "CircuitSamplingSeconds": 10,
    "CircuitBreakSeconds": 15,
    "AttemptTimeoutSeconds": 2
  },
  "AllowedHosts": "*"
}
